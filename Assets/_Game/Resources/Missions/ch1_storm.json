    "debrief":  {
                    "realTeam":  "In June 2018 a giant dust storm covered the sky over Opportunity. Its solar panels made less and less power: 468 Wh on June 3, but only about 22 Wh by June 10. The rover went to sleep to protect itself. June 10 was the last time Earth heard from it. The team kept listening for about 8 months, then ended the mission in February 2019.",
                    "tryNext":  "Turn off the science lab early, before the storm gets bad. Every bit of saved power helps later.",
                    "realScience":  {
                                        "title":  "What is tau?",
                                        "text":  "Tau is a number for how dusty the sky is. Around 0.5 is a clear Mars day. During this storm, tau reached 10.8, one of the dustiest skies ever measured on Mars.",
                                        "glossary":  "tau"
                                    },
                    "sources":  [
                                    "opp2018_power",
                                    "nasa_images"
                                ]
                },
    "days":  null,
